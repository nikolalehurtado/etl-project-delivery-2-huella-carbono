# Copia este archivo como .env y reemplaza los valores.
# Las contrasenas NO deben tener los caracteres @ : /
# Nunca subas el archivo .env al repositorio.

# --- Airflow ---
AIRFLOW_UID=50000
POSTGRES_USER=airflow
POSTGRES_PASSWORD=cambia_esta_contrasena
AIRFLOW__API_AUTH__JWT_SECRET=cambia_este_secreto_largo
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=cambia_esta_contrasena

# --- Data Warehouse (MySQL 8 en Docker) ---
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena
MYSQL_USER=etl_user
MYSQL_PASSWORD=cambia_esta_contrasena
MYSQL_DATABASE=huella_carbono_dw_v2
# Puerto del equipo para conectar Power BI / consultas SQL (dentro de Docker siempre es 3306)
MYSQL_HOST_PORT=3307

# --- API de temperatura IDEAM (datos.gov.co, dataset sbwg-7ju4) ---
# El token es OPCIONAL: sin token funciona con limite de uso mas bajo.
# Se obtiene gratis en https://www.datos.gov.co (perfil > Credenciales de desarrollador).
DATOS_GOV_APP_TOKEN=
# Rango de fechas a extraer (fin exclusivo). La ECV es de 2025.
API_START_DATE=2025-01-01
API_END_DATE=2026-01-01
# Tamano de cada ventana de consulta en dias (ventanas chicas evitan timeouts)
API_WINDOW_DAYS=7
# Minimo de departamentos distintos esperado en la API (regla DQ17; calibrar con el perfilamiento)
API_MIN_DEPARTMENTS=30
