# --- Secretos (nunca subir) ---
.env

# --- Python ---
__pycache__/
*.pyc
venv/
.venv/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Airflow: logs y configuracion generada en cada ejecucion ---
logs/*
!logs/.gitkeep
config/airflow.cfg

# --- Sistema operativo / editor ---
.DS_Store
Thumbs.db
.vscode/

# --- Datos grandes de la ECV (se descargan de DANE; ver README, seccion de instalacion) ---
data/raw/ecv/*
!data/raw/ecv/.gitkeep

# --- Pipeline: intermedios por ejecucion y lotes de prueba generados ---
data/work/*
!data/work/.gitkeep
data/test/*
!data/test/.gitkeep

# --- Great Expectations: resultados por ejecucion (la evidencia elegida se copia a docs/evidence/) ---
gx/validation_results/
